// =====================================================================
//  SECTION 4 : SENSORS + CALIBRATION
// =====================================================================

// readS(): every sensor read goes through this. It always returns a value
// where LINE = LOW and BACKGROUND = HIGH, whatever the arena colour is.
// So calibration, PID and junction detection work the same in both arenas.
int readS(uint8_t ch) {
  int v = analogRead(ch);
  bool lineIsWhite = (mode == 0);
  bool lineReadsLow = lineIsWhite ? (SENSOR_WHITE_IS_LOW == 1)
                                  : (SENSOR_WHITE_IS_LOW == 0);
  return lineReadsLow ? v : (1023 - v);
}

// Spin on the spot and record the min / max value of every sensor.
// threshold = halfway between line and background.
void calib() {
  blue();                                   // LED6 on while calibrating
  for (int i = 0; i < 5; i++) {
    minValues[i] = readS(i);
    maxValues[i] = readS(i);
  }

  for (int i = 0; i < 3000; i++) {
    motor1.drive(60);
    motor2.drive(-60);

    for (int i = 0; i < 5; i++) {
      if (readS(i) < minValues[i]) minValues[i] = readS(i);
      if (readS(i) > maxValues[i]) maxValues[i] = readS(i);
    }
  }

  for (int i = 0; i < 5; i++) {
    threshold[i] = (minValues[i] + maxValues[i]) / 2;
    Serial.print(threshold[i]);
    Serial.print("   ");
  }
  Serial.println();

  motor1.drive(0);
  motor2.drive(0);
  lightsoff();
}


// =====================================================================
//  SECTION 5 : LINE FOLLOWING, PID, JUNCTION DETECTION
// =====================================================================

// Follow the line until something happens: a side sensor sees a line
// (junction / turn / END) or every sensor loses the line (dead end).
void linefollow() {
  paths = 0;
  while ((readS(0) > threshold[0]) &&
         (readS(4) > threshold[4]) &&
         (readS(1) < threshold[1] ||
          readS(2) < threshold[2] ||
          readS(3) < threshold[3])) {
    PID();
  }
  lightsoff();
}

// PID steering: error = left sensor - right sensor
void PID() {
  int error = readS(1) - readS(3);

  P = error;
  I = I + error;
  D = error - previousError;

  PIDvalue = (Kp * P) + (Ki * I) + (Kd * D);
  previousError = error;

  lsp = lfspeed - PIDvalue;
  rsp = lfspeed + PIDvalue;

  if (lsp > 255) lsp = 255;
  if (lsp < 0)   lsp = 0;
  if (rsp > 255) rsp = 255;
  if (rsp < 0)   rsp = 0;

  motor1.drive(rsp);
  motor2.drive(lsp);
}

// Look at the junction and fill in l, s, r, u, e and paths.
void checknode() {
  lightsoff();
  l = 0; r = 0; x = 0; y = 0; s = 0; u = 0; e = 0;
  paths = 0;

  // ---- dead end: no line under any sensor ----
  if ((readS(0) > threshold[0]) &&
      (readS(4) > threshold[4]) &&
      (readS(2) > threshold[2])) {
    u = 1;
    hardBrake();                         // stop right here
  }

  if (u == 0) {
#if SOFT_BRAKE_TURNS
    // SOFT BRAKE: smoothly slow down while scanning the junction
    int baseSpeed = lfspeed;
    int slowSpeed = (long)lfspeed * SOFT_BRAKE_PCT / 100;
#endif
    // ---- scan: drive forward a little and look left / right ----
    for (int i = 0; i < FT; i++) {
#if SOFT_BRAKE_TURNS
      if (i < SOFT_BRAKE_RAMP)
        lfspeed = baseSpeed - (long)(baseSpeed - slowSpeed) * (i + 1) / SOFT_BRAKE_RAMP;
#endif
      PID();
      if (readS(0) < threshold[0]) l = 1;
      if (readS(4) < threshold[4]) r = 1;
    }
#if SOFT_BRAKE_TURNS
    lfspeed = baseSpeed;                 // back to normal speed
#endif

    // ---- is there a line straight ahead?  is this the END zone? ----
    if (readS(2) < threshold[2]) s = 1;
    if ((readS(0) < threshold[0]) &&
        (readS(4) < threshold[4]) &&
        (readS(2) < threshold[2])) e = 2;

#if END_CONFIRM
    // A + crossing can look like the END for a moment. The real END is a
    // big area: the sensors stay on it while moving ahead. A cross-line
    // is thin: the outer sensors reach the background quickly.
    if (e == 2) {
      unsigned long t0 = millis();
      while (millis() - t0 < END_CONFIRM_MS) {
        PID();
        if (readS(0) > threshold[0] || readS(4) > threshold[4]) {
          e = 0;                         // NOT the end: it is a junction
          break;
        }
      }
      if (e == 0) {
        s = (readS(2) < threshold[2]) ? 1 : 0;
      }
    }
#endif
  }

  paths = l + s + r;
}


// =====================================================================
//  SECTION 6 : MOVEMENT (turns, brakes)
// =====================================================================

// Turn LEFT on the spot until the centre sensor finds the new line.
// If a straight line is under the centre sensor, rotate OFF it first,
// otherwise the bot would "find" that straight line again.
void botleft() {
  int offLevel = (threshold[2] + maxValues[2]) / 2;
  bool leftLine = (readS(2) >= threshold[2]);       // already off the line?
  unsigned long t0 = millis();
  while (millis() - t0 < 150) {
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (!leftLine) {                               // still on the straight line
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (readS(2) > threshold[2]) {                 // find the new line
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
  }
  motor1.drive(0);
  motor2.drive(0);
  delay(50);
}

// Turn RIGHT on the spot (same idea as botleft)
void botright() {
  int offLevel = (threshold[2] + maxValues[2]) / 2;
  bool leftLine = (readS(2) >= threshold[2]);
  unsigned long t0 = millis();
  while (millis() - t0 < 250) {
    motor1.drive(turnspeed);
    motor2.drive(-1 * turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (!leftLine) {
    motor1.drive(turnspeed);
    motor2.drive(-1 * turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (readS(2) > threshold[2]) {
    motor1.drive(turnspeed);
    motor2.drive(-1 * turnspeed);
  }
  motor1.drive(0);
  motor2.drive(0);
  delay(50);
}

// U-turn (dead end). If the centre sensor starts ON a line (only when
// leaving the END zone in modes 3/4) it first rotates off that line.
void botuturn() {
  int offLevel = (threshold[2] + maxValues[2]) / 2;
  bool leftLine = (readS(2) >= threshold[2]);
  unsigned long t0 = millis();
  while (millis() - t0 < 200) {
    motor1.drive(-1 * lfspeed);
    motor2.drive(lfspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (!leftLine) {
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (readS(2) > threshold[2]) {
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
  }
  motor1.drive(0);
  motor2.drive(0);
  delay(50);
}

void botstraight() {
  motor1.drive(lfspeed);
  motor2.drive(lfspeed);
}

void botstop() {
  motor1.drive(0);
  motor2.drive(0);
}

// Hard brake: reverse pulse + short brake (used at dead ends)
void hardBrake() {
  motor1.drive(-BRAKE_REVERSE_PWM);
  motor2.drive(-BRAKE_REVERSE_PWM);
  delay(BRAKE_REVERSE_MS);
  motor1.brake();
  motor2.brake();
  delay(BRAKE_HOLD_MS);
  motor1.drive(0);
  motor2.drive(0);
}

// After going STRAIGHT through a junction, keep line-following until the
// outer sensors have left the cross-line, so the same junction is never
// counted twice. Used in the dry run AND the final run.
void clearJunction() {
  unsigned long t0 = millis();
  while ((readS(0) < threshold[0] || readS(4) < threshold[4]) &&
         millis() - t0 < CLEAR_JUNCTION_MS) {
    PID();
  }
}

// A plain bend (only ONE way to go): just take it. Not a decision.
void followCorner() {
  if (r == 1)      botright();
  else if (s == 1) { }
  else if (l == 1) botleft();
}

// Spin right until the centre sensor has reached 'count' lines.
void spinRightLines(uint8_t count) {
  int offLevel = (threshold[2] + maxValues[2]) / 2;            // hysteresis
  motor1.drive(turnspeed);
  motor2.drive(-1 * turnspeed);
  while (readS(2) < offLevel) {                                // leave the line we stand on
    motor1.drive(turnspeed);
    motor2.drive(-1 * turnspeed);
  }
  for (uint8_t k = 0; k < count; k++) {
    while (readS(2) > threshold[2]) {                          // wait for next line
      motor1.drive(turnspeed);
      motor2.drive(-1 * turnspeed);
    }
    if (k + 1 < count) {
      while (readS(2) < offLevel) {                            // pass over it
        motor1.drive(turnspeed);
        motor2.drive(-1 * turnspeed);
      }
    }
  }
  motor1.drive(0);
  motor2.drive(0);
  delay(50);
}


