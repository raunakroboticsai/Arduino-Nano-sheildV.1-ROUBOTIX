// Small TB6612 driver: drive(+speed) = forward, drive(-speed) = backward
class Motor {
  public:
    Motor(uint8_t in1, uint8_t in2, uint8_t pwm, int8_t offset)
      : _in1(in1), _in2(in2), _pwm(pwm), _offset(offset) {}

    void begin() {
      pinMode(_in1, OUTPUT);
      pinMode(_in2, OUTPUT);
      pinMode(_pwm, OUTPUT);
      digitalWrite(_in1, LOW);
      digitalWrite(_in2, LOW);
      analogWrite(_pwm, 0);
    }

    void drive(int speed) {
      speed = speed * _offset;
      if (speed > 255)  speed = 255;
      if (speed < -255) speed = -255;
      if (speed >= 0) {
        digitalWrite(_in1, HIGH);
        digitalWrite(_in2, LOW);
        analogWrite(_pwm, speed);
      } else {
        digitalWrite(_in1, LOW);
        digitalWrite(_in2, HIGH);
        analogWrite(_pwm, -speed);
      }
    }

    void brake() {                 // TB6612 short brake
      digitalWrite(_in1, HIGH);
      digitalWrite(_in2, HIGH);
      analogWrite(_pwm, 0);
    }

  private:
    uint8_t _in1, _in2, _pwm;
    int8_t  _offset;
};

// motor1 = Motor A = LEFT, motor2 = Motor B = RIGHT
Motor motor1 = Motor(AIN1, AIN2, PWMA, offsetA);
Motor motor2 = Motor(BIN1, BIN2, PWMB, offsetB);


