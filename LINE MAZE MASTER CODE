#define NODE_TOL_MS      150    // how close a position must be to count as the same junction
#define NODE_TOL_PCT     15     // + 15% of distance driven since that junction was last seen
#define NODE_TOL_MAX     6      // tolerance never grows above 6 x NODE_TOL_MS
#define CORNER_COST_MS   350    // extra time a plain 90 deg bend costs
#define TURN_COST_MS     450    // extra time a L/R turn at a junction costs in the final run
#define JUNCTION_COST_MS 100    // extra time any junction costs
#define SHORTCUT_RATIO   15     // test a possible short cut if known route > 1.5x straight distance
#define ALIGN_TOL_MS     90     // max sideways offset for two junctions to be "in line"
#define ASTAR_HINT_PCT   90     // A* hint strength in % (<=100 keeps A* exact)

#define MAP_DEBUG        1      // print map + path on Serial after the dry run


