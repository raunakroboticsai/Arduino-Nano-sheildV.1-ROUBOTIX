void setup() {
  Serial.begin(9600);

  motor1.begin();
  motor2.begin();

  pinMode(CALIB_BTN, INPUT_PULLUP);
  pinMode(START_BTN, INPUT_PULLUP);
  pinMode(LED5, OUTPUT);
  pinMode(LED6, OUTPUT);
  lightsoff();

  pinMode(IMPELLER_PIN, OUTPUT);
  analogWrite(IMPELLER_PIN, 0);

  lfspeed = 80;
  turnspeed = 65;

  Serial.println(mode == 1 ? F("MODE 1: BLACK line on WHITE") : F("MODE 0: WHITE line on BLACK"));
  Serial.println(F("Ready - press CALIB"));
}

// ---------------- button helpers (active LOW, debounced) ----------------
// waits for a full press + release of 'pin'
void waitPress(uint8_t pin) {
  while (true) {
    while (digitalRead(pin) == HIGH) {}
    delay(30);
    if (digitalRead(pin) == LOW) break;      // real press, not a bounce
  }
  while (digitalRead(pin) == LOW) {}         // wait for release
  delay(30);
}

// waits for CALIB or START, returns the pin that was pressed
uint8_t waitAnyPress() {
  while (true) {
    if (digitalRead(CALIB_BTN) == LOW) {
      delay(30);
      if (digitalRead(CALIB_BTN) == LOW) {
        while (digitalRead(CALIB_BTN) == LOW) {}
        delay(30);
        return CALIB_BTN;
      }
    }
    if (digitalRead(START_BTN) == LOW) {
      delay(30);
      if (digitalRead(START_BTN) == LOW) {
        while (digitalRead(START_BTN) == LOW) {}
        delay(30);
        return START_BTN;
      }
    }
  }
}

void loop() {

  // ---------- 1) CALIBRATION (CALIB button) ----------
  waitPress(CALIB_BTN);
  delay(1000);
  calib();

  analogWrite(IMPELLER_PIN, IMPELLER_PWM);

  // ---------- 2) DRY RUN (START button) ----------
  if (endFound == 0) {
    waitPress(START_BTN);
    delay(1000);

#if USE_LOOP_MAPPING
    mapInit();
#endif

    while (endFound == 0) {
      linefollow();
      checknode();
      reposition();
    }

#if USE_LOOP_MAPPING
    mappingActive = false;
    if (!pathPlanned) {
      pathPlanned = true;
      // replaces str with the shortest L/S/R..E path; if it can't, the
      // legacy string + the replace rules below are used as before
      planShortestPath();
    }
#endif

    // RIGHT HAND RULE PATH OPTIMIZATION
    for (int m = 0; m < 4; m++) {
      str.replace("RUR", "S");
      str.replace("SUR", "L");
      str.replace("RUS", "L");
      str.replace("LUR", "U");
    }
    Serial.print(F("RUN PATH "));
    Serial.println(str);
  }

  // ---------- 3) ACTUAL RUN(S) ----------
  // START = run the shortest path (again), CALIB = re-calibrate sensors
  while (true) {
    uint8_t b = waitAnyPress();
    if (b == CALIB_BTN) {
      analogWrite(IMPELLER_PIN, 0);
      delay(1000);
      calib();
      analogWrite(IMPELLER_PIN, IMPELLER_PWM);
      continue;
    }
    lightsoff();
    delay(1000);
    actualRun();
  }
}

void actualRun() {
  int endpos = str.indexOf('E');

  for (int i = 0; i <= endpos; i++) {
    char node = str.charAt(i);
    paths = 0;
    while (paths < 2) {
      linefollow();
      checknode();
      if (paths == 1) {
        reposition();
      }
    }

    switch (node) {
      case 'L':
        botstop();
        delay(50);
        botleft();
        break;

      case 'S':
        clearJunction();            // FIX: drive off the cross-line so it isn't counted twice
        break;

      case 'R':
        botstop();
        delay(50);
        botright();
        break;

      case 'E':
        botstop();
        endBlink();                 // FINAL RUN end: both LEDs blink
        break;
    }
  }
  botstop();
}

void calib() {
  blue();                                   // LED6 on while calibrating
  for (int i = 0; i < 5; i++) {
    minValues[i] = readS(i);
    maxValues[i] = readS(i);
  }

  for (int i = 0; i < 3000; i++) {
    motor1.drive(60);
    motor2.drive(-60);

    for (int i = 0; i < 5; i++) {
      if (readS(i) < minValues[i]) minValues[i] = readS(i);
      if (readS(i) > maxValues[i]) maxValues[i] = readS(i);
    }
  }

  for (int i = 0; i < 5; i++) {
    threshold[i] = (minValues[i] + maxValues[i]) / 2;
    Serial.print(threshold[i]);
    Serial.print("   ");
  }
  Serial.println();

  motor1.drive(0);
  motor2.drive(0);
  lightsoff();
}

void checknode() {
  lightsoff();
  l = 0; r = 0; x = 0; y = 0; s = 0; u = 0; e = 0;
  paths = 0;

  if ((readS(0) > threshold[0]) &&
      (readS(4) > threshold[4]) &&
      (readS(2) > threshold[2])) {
    u = 1;
    hardBrake();          // DEAD END: stop right here (old code drove forward 100 ms)
  }

  if (u == 0) {
#if SOFT_BRAKE_TURNS
    // SOFT BRAKE: a side line was just detected (turn / junction ahead).
    // Smoothly ramp the speed down while the bot scans the junction, so it
    // does not run too far past it. Speed is restored right after.
    int baseSpeed = lfspeed;
    int slowSpeed = (long)lfspeed * SOFT_BRAKE_PCT / 100;
#endif
    for (int i = 0; i < FT; i++) {
#if SOFT_BRAKE_TURNS
      if (i < SOFT_BRAKE_RAMP)
        lfspeed = baseSpeed - (long)(baseSpeed - slowSpeed) * (i + 1) / SOFT_BRAKE_RAMP;
#endif
      PID();
      if (readS(0) < threshold[0]) l = 1;
      if (readS(4) < threshold[4]) r = 1;
    }
#if SOFT_BRAKE_TURNS
    lfspeed = baseSpeed;                  // back to normal speed
#endif

    if (readS(2) < threshold[2]) s = 1;
    if ((readS(0) < threshold[0]) &&      // was threshold[3] (typo) in old code
        (readS(4) < threshold[4]) &&
        (readS(2) < threshold[2])) e = 2;

#if END_CONFIRM
    // END CONFIRMATION: at a + crossing the bot can still be sitting on the
    // white cross-line after the scan, which looked exactly like the END.
    // Real END = big white area -> sensors stay on white while moving ahead.
    // Cross-line = thin tape -> left/right sensors reach black quickly.
    if (e == 2) {
      unsigned long t0 = millis();
      while (millis() - t0 < END_CONFIRM_MS) {
        PID();
        if (readS(0) > threshold[0] || readS(4) > threshold[4]) {
          e = 0;                            // NOT the end: it is a junction
          break;
        }
      }
      if (e == 0) {
        s = (readS(2) < threshold[2]) ? 1 : 0;   // re-check the straight line
      }
    }
#endif
  }

  paths = l + s + r;
}

// LEDs moved: old D8/D2 are now motor pins, so use LED5 (D12) / LED6 (D10)
void red()  { digitalWrite(LED5, HIGH); }
void blue() { digitalWrite(LED6, HIGH); }

// END found: blink LED5 + LED6 together, then switch them off
#define END_BLINK_COUNT 10     // number of blinks
#define END_BLINK_MS    250    // on time = off time (10 x 500 ms = 5 s)
void endBlink() {
  for (int i = 0; i < END_BLINK_COUNT; i++) {
    digitalWrite(LED5, HIGH);
    digitalWrite(LED6, HIGH);
    delay(END_BLINK_MS);
    digitalWrite(LED5, LOW);
    digitalWrite(LED6, LOW);
    delay(END_BLINK_MS);
  }
}

void lightsoff() {
  digitalWrite(LED5, LOW);
  digitalWrite(LED6, LOW);
}

void linefollow() {
  paths = 0;
  while ((readS(0) > threshold[0]) &&
         (readS(4) > threshold[4]) &&
         (readS(1) < threshold[1] ||
          readS(2) < threshold[2] ||
          readS(3) < threshold[3])) {
    PID();
  }
  lightsoff();
}

void PID() {
  int error = readS(1) - readS(3);

  P = error;
  I = I + error;
  D = error - previousError;

  PIDvalue = (Kp * P) + (Ki * I) + (Kd * D);
  previousError = error;

  lsp = lfspeed - PIDvalue;
  rsp = lfspeed + PIDvalue;

  if (lsp > 255) lsp = 255;
  if (lsp < 0)   lsp = 0;
  if (rsp > 255) rsp = 255;
  if (rsp < 0)   rsp = 0;

  motor1.drive(rsp);
  motor2.drive(lsp);
}

void reposition() {
  lightsoff();

#if USE_LOOP_MAPPING
  if (mappingActive) {          // dry run: loop-aware decision
    mapReposition();
    if (e != 2) lightsoff();    // keep red LED on at the end, like before
    return;
  }
#endif

  if (e == 2) {
    str += 'E';
    endFound = 1;
    motor1.brake();
    motor2.brake();
    delay(80);

    botstop();
    endBlink();                     // END: both LEDs blink
    return;
  }

  // RIGHT HAND RULE PRIORITY
  else if (r == 1) {
    if (paths > 1) str += 'R';
    botright();
  }

  else if (s == 1) {
    if (paths > 1) { str += 'S'; clearJunction(); }
  }

  else if (l == 1) {
    if (paths > 1) str += 'L';
    botleft();
  }

  else if (u == 1) {
    str += 'U';
    botuturn();
  }
  lightsoff();
}

void botleft() {
  // FIX: if a straight line is under the centre sensor, the bot must rotate
  // OFF it before looking for the new line - otherwise it "finds" the straight
  // line again and goes straight instead of turning left.
  int offLevel = (threshold[2] + maxValues[2]) / 2;
  bool leftLine = (readS(2) >= threshold[2]);       // already off the line?
  unsigned long t0 = millis();
  while (millis() - t0 < 150) {                     // same 150 ms spin as before
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (!leftLine) {                               // still on the straight line
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (readS(2) > threshold[2]) {
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
  }
  motor1.drive(0);
  motor2.drive(0);
  delay(50);
}

void botright() {
  // FIX: rotate OFF a straight line first (same idea as botleft)
  int offLevel = (threshold[2] + maxValues[2]) / 2;
  bool leftLine = (readS(2) >= threshold[2]);       // already off the line?
  unsigned long t0 = millis();
  while (millis() - t0 < 250) {                     // same 250 ms spin as before
    motor1.drive(turnspeed);
    motor2.drive(-1 * turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (!leftLine) {                               // still on the straight line
    motor1.drive(turnspeed);
    motor2.drive(-1 * turnspeed);
    if (readS(2) > offLevel) leftLine = true;
  }
  while (readS(2) > threshold[2]) {
    motor1.drive(turnspeed);
    motor2.drive(-1 * turnspeed);
  }
  motor1.drive(0);
  motor2.drive(0);
  delay(50);
}

void botstraight() {
  motor1.drive(lfspeed);
  motor2.drive(lfspeed);
}

// Hard brake: reverse pulse + short brake, so the bot stops on the spot
// even at high speed instead of rolling past the dead end.
void hardBrake() {
  motor1.drive(-BRAKE_REVERSE_PWM);
  motor2.drive(-BRAKE_REVERSE_PWM);
  delay(BRAKE_REVERSE_MS);
  motor1.brake();
  motor2.brake();
  delay(BRAKE_HOLD_MS);
  motor1.drive(0);
  motor2.drive(0);
}

// After going STRAIGHT through a junction, keep line-following until the
// left/right sensors have left the cross-line. Without this the same
// junction can be detected twice, which shifts every following L/S/R in
// the final run by one junction. Used in dry run AND final run.
void clearJunction() {
  unsigned long t0 = millis();
  while ((readS(0) < threshold[0] || readS(4) < threshold[4]) &&
         millis() - t0 < CLEAR_JUNCTION_MS) {
    PID();
  }
}

void botstop() {
  motor1.drive(0);
  motor2.drive(0);
}

void botuturn() {
  motor1.drive(-1 * lfspeed);
  motor2.drive(lfspeed);
  delay(200);
  while (readS(2) > threshold[2]) {
    motor1.drive(-1 * turnspeed);
    motor2.drive(turnspeed);
  }
  motor1.drive(0);
  motor2.drive(0);
  delay(50);
}

