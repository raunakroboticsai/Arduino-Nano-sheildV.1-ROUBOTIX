// =====================================================================
//  LOOP-AWARE MAZE SOLVER  -  ArduinoShieldV1 (new shield) version
//  Arduino Nano + 2x TB6612FNG
//
//  NEW SHIELD PIN MAP
//    Motor A (LEFT)  : AIN1 = D4, AIN2 = D2, PWMA = D5
//    Motor B (RIGHT) : BIN1 = D7, BIN2 = D8, PWMB = D6
//    (STBY is tied HIGH on the shield - no pin needed)
//    CALIB button    : D13  (INPUT_PULLUP, pressed = LOW)
//    START button    : D11  (INPUT_PULLUP, pressed = LOW)
//    LED5            : D12  (used as "red"  = END found)
//    LED6            : D10  (used as "blue")
//    Impeller (ESC)  : D3   (PWM)
//    Line sensors    : A0..A4 (unchanged)
//
//  HOW TO RUN
//    1. Press CALIB  -> bot spins and calibrates sensors, impeller starts
//    2. Press START  -> DRY RUN (explores + maps the maze)
//    3. Press START  -> ACTUAL RUN (shortest path). Press START again to
//                       repeat the actual run as many times as you want.
//       Press CALIB at this stage any time to re-calibrate (the learned
//       path is kept).
// =====================================================================

// =====================================================================
//  ARENA MODE  <<< CHANGE ONLY THIS FOR EACH ARENA >>>
//    mode = 1 : BLACK line on WHITE background
//    mode = 0 : WHITE line on BLACK background
// =====================================================================
int mode = 0;

// Sensor hardware type - set ONCE for your sensor board, then leave it.
//   1 = sensor gives a LOW reading on WHITE (normal analog IR / TCRT5000)
//   0 = sensor gives a LOW reading on BLACK
// Quick check: open Serial Monitor, hold the bot over white -> if A0..A4
// read low (~100) keep 1, if they read high (~900) put 0.
#define SENSOR_WHITE_IS_LOW 1

// ---------------- Impeller ----------------
#define IMPELLER_PIN 3
#define IMPELLER_PWM 20

// ---------------- Dead-end HARD BRAKE (tune these) ----------------
// At a dead end the bot gives a short reverse pulse to kill its speed,
// then holds a TB6612 short brake, then does the U-turn.
#define BRAKE_REVERSE_PWM 150   // strength of the reverse pulse (0-255)
#define BRAKE_REVERSE_MS  40    // length of the reverse pulse. Bot rolls back? -> lower it.
                                //   Still overshoots? -> raise it (try 50-70)
#define BRAKE_HOLD_MS     80    // short-brake hold time before the turn

// ---------------- SOFT BRAKE for turns (tune these) ----------------
// As soon as a turn / junction is detected, the bot smoothly slows down
// (never stops) so it doesn't overshoot before turning.
#define SOFT_BRAKE_TURNS 1     // 1 = on, 0 = off (exact old behaviour)
#define SOFT_BRAKE_PCT   60    // slow down to this % of lfspeed (higher = more subtle)
#define SOFT_BRAKE_RAMP  30    // ramp length in loop steps (lower = faster slow-down)

// ---------------- END confirmation (tune these) ----------------
// Stops a + crossing (white cross-line) from being taken as the END.
#define END_CONFIRM      1     // 1 = on, 0 = off (old behaviour)
#define END_CONFIRM_MS   150   // must stay on white this long to count as END.
                               //   Crossing still taken as END? -> raise (200-250)
                               //   Bot rolls too far into END zone? -> lower (100)

// ---------------- Junction handling (final-run fixes) ----------------
#define CLEAR_JUNCTION_MS 300  // max time to drive off a cross-line after going straight

// ---------------- Buttons + LEDs ----------------
#define CALIB_BTN 13
#define START_BTN 11
#define LED5      12      // "red"
#define LED6      10      // "blue"

// ---------------- TB6612 pins (new shield) ----------------
