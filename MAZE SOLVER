#if USE_LOOP_MAPPING

uint8_t getArr(uint8_t n, uint8_t d) {
  return (nodes[n].arrH >> (2 * d)) & 3;
}

// how far (ms) a position may be from node j and still be node j
uint32_t nodeTol(uint8_t j) {
  uint32_t seen = (uint32_t)nodes[j].seenOdo * 8UL;
  uint32_t since = (odoMs > seen) ? (odoMs - seen) : 0;
  uint32_t t = (uint32_t)NODE_TOL_MS + since * NODE_TOL_PCT / 100UL;
  if (t > 4UL * NODE_TOL_MS) t = 4UL * NODE_TOL_MS;
  return t;
}

void mapInit() {
  nodeCount = 1;                       // node 0 = start (a line end)
  nodes[0].px = 0;
  nodes[0].py = 0;
  nodes[0].exits = 1;                  // only line goes forward (direction 0)
  nodes[0].type = NT_DEADEND;
  for (uint8_t d = 0; d < 4; d++) {
    nodes[0].nbr[d] = NO_NODE;
    nodes[0].cost[d] = 0;
  }
  nodes[0].arrH = 0;
  nodes[0].seenOdo = 0;
  curNode = 0;
  curExit = 0;
  heading = 0;
  endNode = NO_NODE;
  posX = 0;
  posY = 0;
  odoMs = 0;
  edgeMs = 0;
  mapBroken = false;
  verifyTarget = NO_NODE;
  verifyOrigin = NO_NODE;
  returnTo = NO_NODE;
  verifyBent = false;
  mappingActive = true;
  segStartMs = millis();
}

void linkEdge(uint8_t a, uint8_t da, uint8_t b, uint8_t db, uint32_t c, uint8_t hArr) {
  if (c > 60000UL) c = 60000UL;
  if (nodes[a].nbr[da] == b) c = (c + nodes[a].cost[da]) / 2;   // driven before: average
  nodes[a].nbr[da] = b;
  nodes[a].cost[da] = (uint16_t)c;
  nodes[a].arrH = (nodes[a].arrH & ~(3 << (2 * da))) | (hArr << (2 * da));
  nodes[b].nbr[db] = a;
  nodes[b].cost[db] = (uint16_t)c;
  uint8_t hBack = (da + 2) & 3;
  nodes[b].arrH = (nodes[b].arrH & ~(3 << (2 * db))) | (hBack << (2 * db));
}

// find (or create) the node the bot is standing on and connect the edge just driven
uint8_t registerNode(uint8_t type, uint8_t ex, uint8_t back, bool *isNew) {
  uint8_t n = NO_NODE;
  *isNew = false;

  // 1) we drove along an edge we already know -> we know where we are
  if (curNode != NO_NODE && nodes[curNode].nbr[curExit] != NO_NODE) {
    uint8_t k = nodes[curNode].nbr[curExit];
    if (nodes[k].type == type) n = k;
  }

  // 2) new edge: did it bring us back to a junction we have seen (loop closed)?
  if (n == NO_NODE) {
    uint32_t best = 0xFFFFFFFFUL;
    for (uint8_t j = 0; j < nodeCount; j++) {
      if (nodes[j].type != type || nodes[j].exits != ex) continue;
      if (nodes[j].nbr[back] != NO_NODE) continue;      // that side already leads elsewhere
      if (j == curNode && back == curExit) continue;
      int32_t dx = posX - nodes[j].px; if (dx < 0) dx = -dx;
      int32_t dy = posY - nodes[j].py; if (dy < 0) dy = -dy;
      uint32_t dd = (uint32_t)((dx > dy) ? dx : dy);
      if (dd <= nodeTol(j) && dd < best) {
        best = dd;
        n = j;
      }
    }
  }

  if (n == NO_NODE) {                                   // 3) brand new junction
    if (nodeCount >= MAX_NODES) return NO_NODE;
    n = nodeCount++;
    if (posX > 32000) posX = 32000;
    if (posX < -32000) posX = -32000;
    if (posY > 32000) posY = 32000;
    if (posY < -32000) posY = -32000;
    nodes[n].px = (int16_t)posX;
    nodes[n].py = (int16_t)posY;
    nodes[n].exits = ex;
    nodes[n].type = type;
    for (uint8_t d = 0; d < 4; d++) {
      nodes[n].nbr[d] = NO_NODE;
      nodes[n].cost[d] = 0;
    }
    nodes[n].arrH = 0;
    *isNew = true;
  } else {
    posX = nodes[n].px;                                 // re-anchor: removes drift
    posY = nodes[n].py;
  }
  nodes[n].seenOdo = (uint16_t)(odoMs / 8UL);
  if (curNode != NO_NODE) linkEdge(curNode, curExit, n, back, edgeMs, heading);
  return n;
}

// shortest known driving time between two nodes (to == NO_NODE: nearest node that
// still has an unexplored line). firstExit = exit to take from 'from'.
uint32_t graphDist(uint8_t from, uint8_t to, uint8_t *firstExit) {
  uint32_t dist[MAX_NODES];
  uint8_t first[MAX_NODES];
  uint8_t done[MAX_NODES];
  for (uint8_t i = 0; i < MAX_NODES; i++) {
    dist[i] = 0xFFFFFFFFUL;
    first[i] = NO_NODE;
    done[i] = 0;
  }
  dist[from] = 0;
  *firstExit = NO_NODE;
  uint8_t pick = NO_NODE;          // frontier mode: most recently visited unfinished junction

  while (true) {
    uint8_t un = NO_NODE;
    uint32_t bd = 0xFFFFFFFFUL;
    for (uint8_t i = 0; i < nodeCount; i++) {
      if (!done[i] && dist[i] < bd) {
        bd = dist[i];
        un = i;
      }
    }
    if (un == NO_NODE) {
      if (to == NO_NODE && pick != NO_NODE) {
        *firstExit = first[pick];
        return dist[pick];
      }
      return 0xFFFFFFFFUL;
    }
    done[un] = 1;

    if (un != from) {
      if (to == NO_NODE) {
        if (nodes[un].type == NT_JUNCTION) {
          for (uint8_t d = 0; d < 4; d++) {
            if ((nodes[un].exits & (1 << d)) && nodes[un].nbr[d] == NO_NODE) {
              // backtrack like Tremaux: prefer the junction we left most recently,
              // so the Right-Hand-Rule exploration carries on where it was
              if (pick == NO_NODE || nodes[un].seenOdo > nodes[pick].seenOdo) pick = un;
              break;
            }
          }
        }
      } else if (un == to) {
        *firstExit = first[un];
        return bd;
      }
      if (nodes[un].type != NT_JUNCTION) continue;    // can't drive through a line end
    }

    for (uint8_t d = 0; d < 4; d++) {
      uint8_t v = nodes[un].nbr[d];
      if (v == NO_NODE || done[v]) continue;
      uint32_t nd = bd + nodes[un].cost[d] + JUNCTION_COST_MS;
      if (nd < dist[v]) {
        dist[v] = nd;
        first[v] = (un == from) ? d : first[un];
      }
    }
  }
}

// is node m straight ahead of node n in direction d?
bool aheadAligned(uint8_t n, uint8_t d, uint8_t m) {
  int32_t rx = (int32_t)nodes[m].px - nodes[n].px;
  int32_t ry = (int32_t)nodes[m].py - nodes[n].py;
  int32_t along = rx * DIRX[d] + ry * DIRY[d];
  int32_t perp = rx * DIRY[d] - ry * DIRX[d];
  if (perp < 0) perp = -perp;
  return along > (int32_t)NODE_TOL_MS && perp <= (int32_t)ALIGN_TOL_MS;
}

// unexplored exit d of node n points straight at a known junction whose
// facing line is also unexplored, and the known way round is much longer.
// returns that junction, or NO_NODE
uint8_t shortcutTarget(uint8_t n, uint8_t d) {
  uint8_t m = NO_NODE;
  int32_t bestAlong = 0x7FFFFFFFL;
  for (uint8_t j = 0; j < nodeCount; j++) {
    if (j == n) continue;
    int32_t rx = (int32_t)nodes[j].px - nodes[n].px;
    int32_t ry = (int32_t)nodes[j].py - nodes[n].py;
    int32_t along = rx * DIRX[d] + ry * DIRY[d];
    int32_t perp = rx * DIRY[d] - ry * DIRX[d];
    if (perp < 0) perp = -perp;
    if (along <= (int32_t)NODE_TOL_MS) continue;
    if (perp > (int32_t)ALIGN_TOL_MS) continue;
    if (along < bestAlong) {
      bestAlong = along;
      m = j;
    }
  }
  if (m == NO_NODE) return NO_NODE;
  uint8_t facing = (d + 2) & 3;
  if (nodes[m].type != NT_JUNCTION) return NO_NODE;
  if (!(nodes[m].exits & (1 << facing))) return NO_NODE;
  if (nodes[m].nbr[facing] != NO_NODE) return NO_NODE;
  uint8_t fe;
  uint32_t known = graphDist(n, m, &fe);
  if (known == 0xFFFFFFFFUL) return m;
  if (known * 10UL > (uint32_t)bestAlong * SHORTCUT_RATIO) return m;
  return NO_NODE;
}

// pick the absolute direction to leave node n
uint8_t chooseExit(uint8_t n) {
  uint8_t back = (heading + 2) & 3;
  uint8_t fe = NO_NODE;

  if (nodes[n].type != NT_JUNCTION) {                          // line end: U-turn
    if (verifyTarget != NO_NODE) {                             // short-cut test failed
      returnTo = verifyOrigin;
      verifyTarget = NO_NODE;
    }
    return back;
  }

  // testing a short cut?
  if (verifyTarget != NO_NODE) {
    if (n == verifyTarget) {
      verifyTarget = NO_NODE;                                  // confirmed: loop closed
    } else if (!verifyBent && (nodes[n].exits & (1 << heading)) && aheadAligned(n, heading, verifyTarget)) {
      return heading;                                          // junction on the way: keep straight
    } else {
      returnTo = verifyOrigin;                                 // not a short cut: go back
      verifyTarget = NO_NODE;
    }
  }

  // going back to where a failed short-cut test started
  if (returnTo != NO_NODE) {
    if (n == returnTo) {
      returnTo = NO_NODE;
    } else if (graphDist(n, returnTo, &fe) != 0xFFFFFFFFUL && fe != NO_NODE) {
      return fe;
    } else {
      returnTo = NO_NODE;
    }
  }

  uint8_t order[3];                                            // Right-Hand Rule priority
  order[0] = (heading + 1) & 3;                                // right
  order[1] = heading;                                          // straight
  order[2] = (heading + 3) & 3;                                // left
  uint8_t ex = nodes[n].exits;

  // a) an unexplored line that may be a short cut through a loop
  for (uint8_t i = 0; i < 3; i++) {
    uint8_t d = order[i];
    if ((ex & (1 << d)) && nodes[n].nbr[d] == NO_NODE) {
      uint8_t m = shortcutTarget(n, d);
      if (m != NO_NODE) {
        verifyTarget = m;
        verifyOrigin = n;
        verifyBent = false;
        return d;
      }
    }
  }
  // b) Right-Hand Rule, but only over lines not driven yet
  for (uint8_t i = 0; i < 3; i++) {
    uint8_t d = order[i];
    if ((ex & (1 << d)) && nodes[n].nbr[d] == NO_NODE) return d;
  }
  // c) everything here explored: go back to the last junction that still has an unexplored line
  if (graphDist(n, NO_NODE, &fe) != 0xFFFFFFFFUL && fe != NO_NODE) return fe;
  // d) fallback: plain Right-Hand Rule
  for (uint8_t i = 0; i < 3; i++) {
    if (ex & (1 << order[i])) return order[i];
  }
  return back;
}

// spin right until the centre sensor has reached 'count' lines (counts lines,
// no fixed-time spin, so it works at any turn speed)
void spinRightLines(uint8_t count) {
  int offLevel = (threshold[2] + maxValues[2]) / 2;            // hysteresis
  motor1.drive(turnspeed);
  motor2.drive(-1 * turnspeed);
  while (readS(2) < offLevel) {                           // leave the line we stand on
    motor1.drive(turnspeed);
    motor2.drive(-1 * turnspeed);
  }
  for (uint8_t k = 0; k < count; k++) {
    while (readS(2) > threshold[2]) {                     // wait for next line
      motor1.drive(turnspeed);
      motor2.drive(-1 * turnspeed);
    }
    if (k + 1 < count) {
      while (readS(2) < offLevel) {                       // pass over it
        motor1.drive(turnspeed);
        motor2.drive(-1 * turnspeed);
      }
    }
  }
  motor1.drive(0);
  motor2.drive(0);
  delay(50);
}

// turn at the current node to absolute direction d (ex = lines seen here)
void turnToDir(uint8_t d, uint8_t ex) {
  uint8_t rel = (d - heading) & 3;
  if (rel == 1) {
    botright();
  } else if (rel == 3) {
    botleft();
  } else if (rel == 2) {
    if (u == 1) botuturn();                                     // line end: original U-turn
    else if (!(ex & (1 << ((heading + 1) & 3)))) botright();    // no line on the right: next line is the way back
    else if (!(ex & (1 << ((heading + 3) & 3)))) botleft();     // no line on the left
    else spinRightLines(2);                                      // pass the right line, stop on the way back
  }
  heading = d;
}

// dry-run decision at every node (called from reposition())
void mapReposition() {
  uint32_t now = millis();
  uint32_t dt = now - segStartMs;
  posX += (int32_t)DIRX[heading] * (int32_t)dt;
  posY += (int32_t)DIRY[heading] * (int32_t)dt;
  odoMs += dt;
  edgeMs += dt;

  uint8_t back = (heading + 2) & 3;
  bool isNew;

  // ---- END zone: same actions as before ----
  if (e == 2) {
    endNode = registerNode(NT_END, (uint8_t)(1 << back), back, &isNew);
    str += 'E';
    endFound = 1;
    motor1.brake();
    motor2.brake();
    delay(80);
    botstop();
    endBlink();                     // DRY RUN end: both LEDs blink
    return;
  }

  // ---- plain bend: not a decision point ----
  if (u == 0 && paths <= 1) {
    if (verifyTarget != NO_NODE && (r == 1 || l == 1)) verifyBent = true;
    if (r == 1) {
      botright();
      heading = (heading + 1) & 3;
      edgeMs += CORNER_COST_MS;
    } else if (s == 1) {
    } else if (l == 1) {
      botleft();
      heading = (heading + 3) & 3;
      edgeMs += CORNER_COST_MS;
    }
    segStartMs = millis();
    return;
  }

  // ---- junction or line end ----
  uint8_t ex = (uint8_t)(1 << back);
  if (u == 0) {
    if (s == 1) ex |= (1 << heading);
    if (r == 1) ex |= (1 << ((heading + 1) & 3));
    if (l == 1) ex |= (1 << ((heading + 3) & 3));
  }

  uint8_t n = registerNode(u ? NT_DEADEND : NT_JUNCTION, ex, back, &isNew);
  if (n == NO_NODE) {            // map memory full: carry on with the original RHR
    mapBroken = true;
    mappingActive = false;
    reposition();
    return;
  }

  uint8_t d = chooseExit(n);
  if (!(ex & (1 << d))) {        // safety: only ever turn onto a line we can see
    if (r == 1) d = (heading + 1) & 3;
    else if (s == 1) d = heading;
    else if (l == 1) d = (heading + 3) & 3;
    else d = back;
  }

  uint8_t rel = (d - heading) & 3;
  if (u == 1) str += 'U';                     // legacy string kept as a fallback
  else if (paths > 1) str += "SRUL"[rel];

  turnToDir(d, ex);
  if (u == 0 && rel == 0) clearJunction();   // FIX: straight through a junction -> clear it
  curNode = n;
  curExit = d;
  edgeMs = 0;
  segStartMs = millis();
}

// shortest path (time, with turn penalties) over the explored map -> str
bool planShortestPath() {
  if (mapBroken || endNode == NO_NODE) return false;
  const uint8_t NS = MAX_NODES * 4;          // state = node*4 + arrival heading
  uint16_t dist[NS];                         // units of 4 ms
  uint8_t prev[NS];
  uint8_t done[(NS + 7) / 8];
  for (uint8_t i = 0; i < NS; i++) {
    dist[i] = 0xFFFF;
    prev[i] = 0xFF;
  }
  for (uint8_t i = 0; i < (NS + 7) / 8; i++) done[i] = 0;

  uint8_t b = nodes[0].nbr[0];
  if (b == NO_NODE) return false;
  uint8_t s0 = b * 4 + getArr(0, 0);
  dist[s0] = nodes[0].cost[0] / 4;
  prev[s0] = 0xFE;
  uint8_t goal = 0xFF;
  uint8_t ns = nodeCount * 4;

  while (true) {
    uint8_t us = 0xFF;
    uint16_t bd = 0xFFFF;
    for (uint8_t i = 0; i < ns; i++) {
      if (!(done[i >> 3] & (1 << (i & 7))) && dist[i] < bd) {
        bd = dist[i];
        us = i;
      }
    }
    if (us == 0xFF) break;
    done[us >> 3] |= (1 << (us & 7));
    uint8_t n = us >> 2, h = us & 3;
    if (n == endNode) {
      goal = us;
      break;
    }
    if (nodes[n].type != NT_JUNCTION) continue;
    for (uint8_t d = 0; d < 4; d++) {
      uint8_t v = nodes[n].nbr[d];
      if (v == NO_NODE) continue;
      uint8_t rel = (d - h) & 3;
      if (rel == 2) continue;                // no U-turns in the actual run
      uint32_t c = (uint32_t)bd + ((uint32_t)nodes[n].cost[d] + JUNCTION_COST_MS + (rel ? TURN_COST_MS : 0)) / 4;
      if (c > 0xFFFE) c = 0xFFFE;
      uint8_t vs = v * 4 + getArr(n, d);
      if (c < dist[vs]) {
        dist[vs] = (uint16_t)c;
        prev[vs] = us;
      }
    }
  }
  if (goal == 0xFF) return false;

  char buf[MAX_NODES * 2 + 2];
  uint8_t len = 0;
  uint8_t v = goal;
  while (prev[v] != 0xFE) {
    uint8_t us = prev[v];
    uint8_t n = us >> 2, h = us & 3;
    char c = 0;
    for (uint8_t d = 0; d < 4; d++) {
      if (nodes[n].nbr[d] == (v >> 2) && getArr(n, d) == (v & 3)) {
        c = "SRUL"[(d - h) & 3];
        break;
      }
    }
    if (c == 0 || len >= sizeof(buf) - 1) return false;
    buf[len++] = c;
    v = us;
  }

  str = "";
  for (uint8_t i = len; i > 0; i--) str += buf[i - 1];
  str += 'E';

#if MAP_DEBUG
  printMap();
#endif
  return true;
}

void printMap() {
  Serial.print(F("NODES "));
  Serial.println(nodeCount);
  for (uint8_t i = 0; i < nodeCount; i++) {
    Serial.print(i);
    Serial.print(F(" t"));
    Serial.print(nodes[i].type);
    Serial.print(F(" ("));
    Serial.print(nodes[i].px);
    Serial.print(',');
    Serial.print(nodes[i].py);
    Serial.print(F(") "));
    for (uint8_t d = 0; d < 4; d++) {
      if (nodes[i].exits & (1 << d)) {
        if (nodes[i].nbr[d] == NO_NODE) Serial.print('?');
        else Serial.print(nodes[i].nbr[d]);
      } else Serial.print('-');
      Serial.print(' ');
    }
    Serial.println();
  }
  Serial.print(F("PATH "));
  Serial.println(str);
}

