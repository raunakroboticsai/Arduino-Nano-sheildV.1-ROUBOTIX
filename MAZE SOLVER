// ---------------------------------------------------------------------
// readS(): every sensor read in the code goes through this.
// It always returns a value where LINE = LOW and BACKGROUND = HIGH,
// whatever the arena colour is. So calibration, PID, junction / dead-end /
// END-zone detection all work the same for both arenas.
// ---------------------------------------------------------------------
int readS(uint8_t ch) {
  int v = analogRead(ch);
  bool lineIsWhite = (mode == 0);
  bool lineReadsLow = lineIsWhite ? (SENSOR_WHITE_IS_LOW == 1)
                                  : (SENSOR_WHITE_IS_LOW == 0);
  return lineReadsLow ? v : (1023 - v);
}

// =====================================================================
//  LOOP-AWARE MAZE SOLVER  (added for the 2026-27 arena)
//  - Dry run still explores with the Right-Hand Rule, but the bot also
//    keeps a small map (junctions + headings + driving time between them)
//    so it can recognise a junction it has already visited.
//  - It never re-enters a part of the maze it has already explored, so it
//    cannot circle a loop forever.
//  - If a junction has an unexplored line pointing straight at another
//    known junction (the classic "loop detour"), it checks that short cut.
//  - After the dry run, the shortest path over everything it saw is turned
//    into the same L/S/R/E string the actual run already uses, so the
//    actual-run code is untouched.
//  Set USE_LOOP_MAPPING to 0 to get last year's exact behaviour back.
// =====================================================================
#define USE_LOOP_MAPPING 1
#define MAP_DEBUG        1     // print map + final path on Serial after the dry run

#define MAX_NODES        30
#define NO_NODE          255
#define NT_JUNCTION      0
#define NT_DEADEND       1
#define NT_END           2

// Tuning (all in milliseconds of line following at lfspeed)
#define NODE_TOL_MS      150   // ~8 cm: how close a position must be to count as the same junction
#define NODE_TOL_PCT     8     // + 8% of distance driven since that junction was last seen
#define CORNER_COST_MS   350   // extra time a plain 90 deg bend costs
#define TURN_COST_MS     450   // extra time a L/R turn at a junction costs in the actual run
#define JUNCTION_COST_MS 100   // extra time any junction costs (stop / forward step)
#define SHORTCUT_RATIO   15    // test a possible short cut if known route > 1.5x straight distance
#define ALIGN_TOL_MS     90    // ~6 cm: max sideways offset for two junctions to count as "in line"

struct MapNode {
  int16_t  px, py;      // dead-reckoned position (ms of driving)
  uint8_t  exits;       // bit d set = a line leaves this node in absolute direction d
  uint8_t  type;        // NT_JUNCTION / NT_DEADEND / NT_END
  uint8_t  nbr[4];      // node reached through exit d (NO_NODE = not explored yet)
  uint8_t  arrH;        // 2 bits per exit: heading when arriving at that neighbour
  uint16_t cost[4];     // driving time of the edge through exit d
  uint16_t seenOdo;     // odometer/8 when this node was last visited
};

MapNode nodes[MAX_NODES];
uint8_t  nodeCount = 0;
uint8_t  curNode = NO_NODE;   // node we left last
uint8_t  curExit = 0;         // absolute exit we left it by
uint8_t  heading = 0;         // 0 = start direction, 1 = right of it, 2 = back, 3 = left
uint8_t  endNode = NO_NODE;
int32_t  posX = 0, posY = 0;
uint32_t odoMs = 0, edgeMs = 0, segStartMs = 0;
bool     mappingActive = false;
bool     mapBroken = false;
bool     pathPlanned = false;
uint8_t  verifyTarget = NO_NODE;  // junction we expect to reach while testing a short cut
uint8_t  verifyOrigin = NO_NODE;  // junction the short-cut test started from
uint8_t  returnTo = NO_NODE;      // failed test: drive back here, then carry on with RHR
bool     verifyBent = false;

const int8_t DIRX[4] = {0, 1, 0, -1};
const int8_t DIRY[4] = {1, 0, -1, 0};

