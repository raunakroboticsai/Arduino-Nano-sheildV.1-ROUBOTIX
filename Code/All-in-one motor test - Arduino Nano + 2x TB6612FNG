// All-in-one motor test - Arduino Nano + 2x TB6612FNG
// 1 = Forward, 2 = Backward, 3 = Right, 4 = Left, 0 = Stop

#define AIN1 4
#define AIN2 2
#define PWMA 5

#define BIN1 7
#define BIN2 8
#define PWMB 6

int mode = 2;      // start-up par kaunsa move chalega (0-4)
int speedVal = 200; // 0-255

// Motor A = Left, Motor B = Right
void motorA(bool fwd, int spd) {
  digitalWrite(AIN1, fwd ? HIGH : LOW);
  digitalWrite(AIN2, fwd ? LOW : HIGH);
  analogWrite(PWMA, spd);
}

void motorB(bool fwd, int spd) {
  digitalWrite(BIN1, fwd ? HIGH : LOW);
  digitalWrite(BIN2, fwd ? LOW : HIGH);
  analogWrite(PWMB, spd);
}

void stopMotors() {
  analogWrite(PWMA, 0);
  analogWrite(PWMB, 0);
}

void runMode(int m) {
  switch (m) {
    case 1:  // Forward
      motorA(true, speedVal);
      motorB(true, speedVal);
      Serial.println("Forward");
      break;
    case 2:  // Backward
      motorA(false, speedVal);
      motorB(false, speedVal);
      Serial.println("Backward");
      break;
    case 3:  // Right (left motor fwd, right motor back)
      motorA(true, speedVal);
      motorB(false, speedVal);
      Serial.println("Right");
      break;
    case 4:  // Left (left motor back, right motor fwd)
      motorA(false, speedVal);
      motorB(true, speedVal);
      Serial.println("Left");
      break;
    default: // Stop
      stopMotors();
      Serial.println("Stop");
      break;
  }
}

void setup() {
  Serial.begin(9600);

  pinMode(AIN1, OUTPUT); pinMode(AIN2, OUTPUT); pinMode(PWMA, OUTPUT);
  pinMode(BIN1, OUTPUT); pinMode(BIN2, OUTPUT); pinMode(PWMB, OUTPUT);

  Serial.println("Type: 1=Fwd 2=Back 3=Right 4=Left 0=Stop");
  runMode(mode);
}

void loop() {
  if (Serial.available() > 0) {
    char c = Serial.read();
    if (c >= '0' && c <= '4') {
      mode = c - '0';
      runMode(mode);
    }
  }
}
