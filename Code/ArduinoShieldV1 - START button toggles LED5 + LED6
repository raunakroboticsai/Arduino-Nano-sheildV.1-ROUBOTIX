// ArduinoShieldV1 - CALIB + START buttons
// CALIB (D13): 1st press -> LED5 + LED6 ON, 2nd press -> OFF
// START (D11): 1st press -> LED5 + LED6 ON, 2nd press -> OFF

const int CALIB_BTN = 13;
const int START_BTN = 11;
const int LED5 = 12;
const int LED6 = 10;

const unsigned long DEBOUNCE_MS = 50;

bool ledState = false;

struct Button {
  int pin;
  bool lastReading;
  bool stableState;
  unsigned long lastChange;
};

Button calibBtn = {CALIB_BTN, HIGH, HIGH, 0};
Button startBtn = {START_BTN, HIGH, HIGH, 0};

bool wasPressed(Button &b) {
  bool reading = digitalRead(b.pin);
  if (reading != b.lastReading) {
    b.lastChange = millis();
    b.lastReading = reading;
  }
  if ((millis() - b.lastChange) > DEBOUNCE_MS && reading != b.stableState) {
    b.stableState = reading;
    if (b.stableState == LOW) return true;
  }
  return false;
}

void setLeds(bool on) {
  digitalWrite(LED5, on ? HIGH : LOW);
  digitalWrite(LED6, on ? HIGH : LOW);
}

void setup() {
  pinMode(CALIB_BTN, INPUT_PULLUP);
  pinMode(START_BTN, INPUT_PULLUP);
  pinMode(LED5, OUTPUT);
  pinMode(LED6, OUTPUT);
  setLeds(false);

  delay(100);
  calibBtn.lastReading = calibBtn.stableState = digitalRead(CALIB_BTN);
  startBtn.lastReading = startBtn.stableState = digitalRead(START_BTN);

  Serial.begin(9600);
  Serial.println("Ready - press CALIB or START");
}

void loop() {
  bool calib = wasPressed(calibBtn);
  bool start = wasPressed(startBtn);

  if (calib) {
    ledState = !ledState;
    setLeds(ledState);
    Serial.println(ledState ? "CALIB: LEDs ON" : "CALIB: LEDs OFF");
  }

  if (start) {
    ledState = !ledState;
    setLeds(ledState);
    Serial.println(ledState ? "START: LEDs ON" : "START: LEDs OFF");
  }
}
